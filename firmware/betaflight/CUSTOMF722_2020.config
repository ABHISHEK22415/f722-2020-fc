# F722 20x20 flight controller - Betaflight starting config (Rev A pin map)
#
# Status: UNTESTED starting point. Before flashing a real board:
#   - add timer and DMA mappings for each motor and the LED strip
#     (or rely on dshot_bitbang, set below)
#   - check the format against the Betaflight version you build for;
#     Betaflight 4.5+ defines boards in the betaflight/config repo
#   - pins match hardware/pinout.csv

board_name CUSTOMF722_2020
manufacturer_id CUST

define USE_GYRO_SPI_MPU6000
define USE_ACC_SPI_MPU6000
define USE_BARO_DPS310
define USE_FLASH_W25Q128FV
define USE_MAX7456

# motors
resource MOTOR 1 B00
resource MOTOR 2 B01
resource MOTOR 3 C08
resource MOTOR 4 C09
resource MOTOR 5 A00
resource MOTOR 6 A01
resource MOTOR 7 B06
resource MOTOR 8 B07

# outputs and switches
resource LED_STRIP 1 A08
resource CAMERA_CONTROL 1 A15
resource BEEPER 1 C15
resource LED 1 C13
resource LED 2 C14
resource PINIO 1 B02
resource PINIO 2 C03

# serial
resource SERIAL_TX 1 A09
resource SERIAL_RX 1 A10
resource SERIAL_TX 2 A02
resource SERIAL_RX 2 A03
resource SERIAL_TX 3 B10
resource SERIAL_RX 3 B11
resource SERIAL_TX 4 C10
resource SERIAL_RX 4 C11
resource SERIAL_TX 5 C12
resource SERIAL_RX 5 D02
resource SERIAL_TX 6 C06
resource SERIAL_RX 6 C07

# buses
resource I2C_SCL 1 B08
resource I2C_SDA 1 B09
resource SPI_SCK 1 A05
resource SPI_MISO 1 A06
resource SPI_MOSI 1 A07
resource SPI_SCK 2 B13
resource SPI_MISO 2 B14
resource SPI_MOSI 2 B15
resource SPI_SCK 3 B03
resource SPI_MISO 3 B04
resource SPI_MOSI 3 B05

# analog
resource ADC_BATT 1 C00
resource ADC_CURR 1 C01
resource ADC_RSSI 1 C02

# chip selects and interrupts
resource OSD_CS 1 B12
resource FLASH_CS 1 C05
resource GYRO_EXTI 1 C04
resource GYRO_CS 1 A04

set gyro_1_bustype = SPI
set gyro_1_spibus = 1
set max7456_spi_bus = 2
set flash_spi_bus = 3
set baro_bustype = I2C
set baro_i2c_device = 1
set vbat_scale = 110
set pinio_box = 40,41,255,255
set beeper_inversion = ON
set beeper_od = OFF
set system_hse_mhz = 8
set dshot_bitbang = AUTO
